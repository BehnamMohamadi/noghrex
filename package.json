{
  "name": "noghrex-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:local": "node scripts/start-local-db.js",
    "seed:local": "node scripts/seed-local.js",
    "dev:local": "npm run db:local && npm run dev",
    "postman:build": "node scripts/build-postman.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
